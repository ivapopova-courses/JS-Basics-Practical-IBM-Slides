msgid "a string, or `undefined`"
msgstr "string или `undefined`"

#. table cell
#: site/lectures/10-tests-types-git.md:428
msgid "a dictionary: string keys, number values (lecture 6)"
msgstr "dictionary: ключове strings, стойности числа (лекция 6)"

