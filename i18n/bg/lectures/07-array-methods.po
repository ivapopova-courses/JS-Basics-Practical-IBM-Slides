msgid "a new array, same length"
msgstr "нов array със същата дължина"

#. table cell
#: site/lectures/07-array-methods.md:137
msgid "\"keep this element?\" (`true` / `false`)"
msgstr "\"да запазя ли този елемент?\" (`true` / `false`)"

