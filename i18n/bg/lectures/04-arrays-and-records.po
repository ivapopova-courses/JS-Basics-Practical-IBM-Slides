#. table cell
#: site/lectures/04-arrays-and-records.md:1777
msgid "An ordered list; index from 0; `[...]` to create; any type of element"
msgstr ""

#. table cell
#: site/lectures/04-arrays-and-records.md:1778
msgid "Access"
msgstr ""

#. table cell
#: site/lectures/04-arrays-and-records.md:1778
msgid "`arr[i]`; a missing index gives `undefined`, no error; last: `arr[arr.length - 1]` or `arr.at(-1)`"
msgstr ""

#. table cell
#: site/lectures/04-arrays-and-records.md:1779
msgid "Number of elements, one more than the last index; writing to it changes the array; `[]` is truthy - check `length === 0`"
msgstr ""

#. table cell
#: site/lectures/04-arrays-and-records.md:1780
msgid "An object"
msgstr ""

#. table cell
#: site/lectures/04-arrays-and-records.md:1780
msgid "`typeof` is `\"object\"`; use `Array.isArray`; `===` compares references; `const` does not freeze the array"
msgstr ""

#. table cell
#: site/lectures/04-arrays-and-records.md:1781
msgid "Add / remove"
msgstr ""

#. table cell
#: site/lectures/04-arrays-and-records.md:1781
msgid "`push` / `pop` at the end, `unshift` / `shift` at the start, `splice` anywhere - they change the array"
msgstr ""

#. table cell
#: site/lectures/04-arrays-and-records.md:1782
msgid "Copy"
msgstr ""

#. table cell
#: site/lectures/04-arrays-and-records.md:1782
msgid "`slice(start, end)` (end not included), `[...arr]`, `concat` - new arrays"
msgstr ""

#. table cell
#: site/lectures/04-arrays-and-records.md:1783
msgid "Search"
msgstr ""

#. table cell
#: site/lectures/04-arrays-and-records.md:1783
msgid "`indexOf` (index or -1), `includes` (true / false), `lastIndexOf`; exact `===` - normalise first"
msgstr ""

#. table cell
#: site/lectures/04-arrays-and-records.md:1784
msgid "Strings"
msgstr ""

#. table cell
#: site/lectures/04-arrays-and-records.md:1784
msgid "`split(sep)` -> array of strings; `join(sep)` -> string; `\"\".split(\",\")` is `[\"\"]`"
msgstr ""

#. table cell
#: site/lectures/04-arrays-and-records.md:1785
msgid "Loops"
msgstr ""

#. table cell
#: site/lectures/04-arrays-and-records.md:1785
msgid "`for...of` for elements, `for` with `i` for indexes and backwards; not `for...in`"
msgstr ""

#. table cell
#: site/lectures/04-arrays-and-records.md:1786
msgid "Patterns"
msgstr ""

#. table cell
#: site/lectures/04-arrays-and-records.md:1786
msgid "Accumulator (sum, count), max from `arr[0]`, collect with `push`, search with `break`"
msgstr ""

#. table cell
#: site/lectures/04-arrays-and-records.md:1787
msgid "Tables"
msgstr ""

#. table cell
#: site/lectures/04-arrays-and-records.md:1787
msgid "`matrix[row][col]`; nested loops"
msgstr ""

#. table cell
#: site/lectures/04-arrays-and-records.md:1788
msgid "Records"
msgstr ""

#. table cell
#: site/lectures/04-arrays-and-records.md:1788
msgid "An array of objects; find, count, collect in one pass; no search inside a loop"
msgstr ""

#. table cell
#: site/lectures/04-arrays-and-records.md:1789
msgid "Old style"
msgstr ""

#. table cell
#: site/lectures/04-arrays-and-records.md:1789
msgid "`new Array(...)`, `indexOf(x) !== -1`, `for (var i ...)`, `!arr.length` - read it, write the modern form"
msgstr ""

