msgid "`log`, `warn`, `error` (stderr), `table`, `dir` with `{ depth: null }`, `group`, `count`, `time`, `assert`"
msgstr "`log`, `warn`, `error` (stderr), `table`, `dir` с `{ depth: null }`, `group`, `count`, `time`, `assert`"

