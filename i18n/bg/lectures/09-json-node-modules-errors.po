msgstr "\"няма стойност\""

#. table cell
#: site/lectures/09-json-node-modules-errors.md:115
msgid "array"
msgstr "array"

#. table cell
#: site/lectures/09-json-node-modules-errors.md:115
msgid "an ordered list of values"
msgstr "подреден списък от стойности"

#. table cell
#: site/lectures/09-json-node-modules-errors.md:116
msgid "object"
msgstr "object"

#. table cell
#: site/lectures/09-json-node-modules-errors.md:116
msgid "keys are **strings in double quotes**"
msgstr "ключовете са **strings в двойни кавички**"

#. heading 3
#: site/lectures/09-json-node-modules-errors.md:118
msgid "JSON is stricter than JavaScript"
msgstr "JSON е по-строг от JavaScript"

#. table cell
#: site/lectures/09-json-node-modules-errors.md:120
msgid "Allowed in a JavaScript object literal"
msgstr "Позволено в обектен литерал на JavaScript"

#. table cell
#: site/lectures/09-json-node-modules-errors.md:120
msgid "In JSON"
msgstr "В JSON"

#. table cell
#: site/lectures/09-json-node-modules-errors.md:122
msgid "keys without quotes: `{ model: \"XR-220\" }`"
msgstr "ключове без кавички: `{ model: \"XR-220\" }`"

#. table cell
#: site/lectures/09-json-node-modules-errors.md:122
msgid "not allowed - `{ \"model\": \"XR-220\" }`"
msgstr "не е позволено - `{ \"model\": \"XR-220\" }`"

#. table cell
