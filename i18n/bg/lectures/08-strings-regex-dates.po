msgid "`5` - up"
msgstr "`5` - нагоре"

#. table cell
#: site/lectures/08-strings-regex-dates.md:866
msgid "`-4` - drop the decimals"
msgstr "`-4` - махат се десетичните знаци"

#. table cell
